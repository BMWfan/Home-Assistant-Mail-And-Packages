Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\dhllogin]
@="URL:DHL Login Helper"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\dhllogin\shell\open\command]
@="powershell -NoProfile -WindowStyle Hidden -Command \"Add-Type -AssemblyName System.Windows.Forms | Out-Null; Set-Clipboard -Value '%1'; [System.Windows.Forms.MessageBox]::Show('%1','DHL Code - bereits in die Zwischenablage kopiert') | Out-Null\""