# Credentials checklist for the Mail and Packages integration.
#
# IMPORTANT: this integration is configured entirely through the HA UI
# config flow (Settings > Devices & Services > Add Integration > Mail and
# Packages) -- it does NOT read secrets.yaml itself, there is no
# configuration.yaml platform entry for it. Credentials you enter in the
# wizard are stored in HA's own storage (config/.storage/core.config_entries),
# not here.
#
# This file exists so you have everything gathered *before* you start the
# wizard, and so the values have somewhere safe (git-ignored) to live if you
# want to copy-paste them. Copy this file to config/secrets.yaml, fill it in,
# and keep it next to you while running the wizard -- config/secrets.yaml
# itself is git-ignored (see config/* rule in .gitignore).

# ── IMAP mailbox (required) ─────────────────────────────────────────────────
# The mailbox the integration scans for shipping notification emails.
# Auth type "Password" (the config flow default) is the simplest to test
# with in a fresh container -- no OAuth app registration needed. Most
# providers require an APP PASSWORD here, not your normal account password
# (Outlook/Microsoft 365: Security > App passwords; Gmail: App passwords,
# requires 2FA enabled first).
mail_host: outlook.office365.com   # or imap.gmail.com, etc.
mail_port: 993
mail_username: you@example.com
mail_password: "REPLACE_ME_APP_PASSWORD"
mail_folder: INBOX                 # or a subfolder, e.g. INBOX/Shipping

# ── OAuth (optional -- only if using auth_type Microsoft/Google in the
#    wizard instead of Password) ────────────────────────────────────────────
# Registered once via Settings > Application Credentials in the HA UI (or a
# configuration.yaml `application_credentials:` block referencing these same
# secret names). Needs an app registered in Azure AD / Google Cloud Console
# with an OAuth redirect URI pointing back at this HA instance
# (http://<host>:8123/auth/external/callback) -- not practical for a
# throwaway container without a stable reachable URL, so start with
# Password auth unless you specifically need to test the OAuth path.
oauth_microsoft_client_id: "REPLACE_ME"
oauth_microsoft_client_secret: "REPLACE_ME"
oauth_google_client_id: "REPLACE_ME"
oauth_google_client_secret: "REPLACE_ME"

# ── 17track (optional) ───────────────────────────────────────────────────
# Enables real-time carrier status/history via the 17track.net API instead
# of relying only on email text. Free tier API key from
# https://features.17track.net/en/api -- entered in the wizard's
# "17track API key" step.
seventeen_track_api_key: "REPLACE_ME"

# ── Amazon order detection (optional) ───────────────────────────────────
# amazon_domain must match the TLD of the Amazon emails you actually
# receive (amazon.de, amazon.com, ...). amazon_fwds is only needed if
# Amazon order emails arrive via a forwarding service (e.g. SimpleLogin)
# rather than directly.
amazon_domain: amazon.de
amazon_fwds: ""

# ── DHL Briefankündigung (optional, DE only) ────────────────────────────
# No static secret here -- it's a live browser login (PKCE OAuth against
# login.dhl.de) triggered from the integration's own config/options flow,
# can't be pre-seeded via this file. See HANDOFF.md for the auth chain
# details if you need to touch that code path.
