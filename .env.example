# Copy to .env and adjust if you cloned the companion card repo
# (github.com/BMWfan/Home-Assistant-Mail-And-Packages-Custom-Card) somewhere
# other than as a sibling directory named "mail-packages-card", or under its
# full GitHub name. docker-compose.yml falls back to
# ../mail-packages-card/dist if this isn't set.
#
# CARD_DIST_PATH=../Home-Assistant-Mail-And-Packages-Custom-Card/dist

# ── HA onboarding (optional) ────────────────────────────────────────────────
# When set, the bootstrap-owner service creates the initial Home Assistant
# owner account automatically on `docker compose up`, skipping the browser
# onboarding wizard. Leave unset to onboard manually.
# This is HA's own account -- NOT the IMAP mailbox credentials, which are
# entered in the integration's config flow (see config/secrets.yaml.example).
# HA_OWNER_USERNAME=daniel
# HA_OWNER_PASSWORD=
# HA_OWNER_NAME=Daniel
